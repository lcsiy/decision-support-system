# Tushare Pro 配置（必填）
TUSHARE_TOKEN=your_tushare_token_here

# 数据库配置
DB_PATH=./data/decisions.db

# 系统配置
LOG_LEVEL=INFO
MAX_WORKERS=20
CACHE_TTL_HOURS=72

# 股票过滤配置
EXCLUDE_MARKETS=688,300,8
INCLUDE_PREFIXES=600,000,001,002,003

# 分析配置
TOP_N_STOCKS=20
MIN_CONFIDENCE_SCORE=0.6
ANALYSIS_DAYS_HISTORY=730

# 价格建议配置
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.08
MIN_RISK_REWARD_RATIO=2.0

# 仓位管理配置
MAX_POSITION_PCT=10.0

# 数据目录（可选，使用默认值即可）
# MINUTE_DATA_DIR=./data/minute_data
# FEEDBACK_DIR=./data/feedback
# REPORT_DIR=./data/reports

# 尾盘分析默认参数（可选）
# DEFAULT_HOT_LIMIT=300
# DEFAULT_MIN_LIQUIDITY=10000000

# 两维度权重 (v9.0)
MOMENTUM_WEIGHT=0.60
SENTIMENT_WEIGHT=0.40

# ========================================
# LLM 配置 (DSS_* 优先；TRADINGAGENTS_* 兼容读取)
# ========================================
DSS_LLM_PROVIDER=deepseek
DSS_QUICK_THINK_LLM=deepseek-v4-pro
DSS_DEEP_THINK_LLM=deepseek-v4-pro
DSS_LLM_BACKEND_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DSS_OUTPUT_LANGUAGE=Chinese
